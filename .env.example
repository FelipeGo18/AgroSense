# Copie este archivo como .env. El .env no va a git: cada quien tiene el suyo.

# PostgreSQL local de Docker Compose (cuentas, lotes y temporadas). Valores solo para desarrollo. Las pruebas usan
# siempre esta base, aunque la API apunte a la nube.
POSTGRES_DB=agrosense
POSTGRES_USER=agrosense
POSTGRES_PASSWORD=cambie-esta-clave-local
POSTGRES_PORT=5432

# Base de datos en la nube, la del equipo y la demo. Con la cadena de conexión, la API usa esa base en vez de la local,
# exige SSL y no la migra sola al arrancar (backend/README.md, «Base de datos en la nube»). Vacía o comentada: la base
# local. La cadena trae la clave: va solo en su .env, nunca en git ni en un chat.
# AGROSENSE_DATABASE_URL=postgresql://<usuario>:<clave>@<host>:5432/<base>
# Para que la API migre la base de la nube al arrancar (solo en el despliegue, si se decide así): true.
# AGROSENSE_AUTO_MIGRATE=

# API. Orígenes de la web que pueden cambiar datos (protección contra CSRF), separados por coma.
WEB_ORIGINS=http://localhost:5173
API_PORT=8000
# Documentación de la API en /api/docs y /api/openapi.json (la usa `npm run api:types`). Solo en desarrollo:
# sin esta variable queda apagada, que es lo que debe pasar en producción.
AGROSENSE_API_DOCS=true

# Precios de SIPSA al día (HU-222). Los actualiza el servicio `market` de Docker Compose con dos crons
# (`docker compose --profile market up -d market`; sin ese perfil no arranca y no se usa la red). La API nunca baja nada:
# solo lee las versiones de esta carpeta (en Compose, el volumen `market_data`).
AGROSENSE_MARKET_DIR=data/market
# Horarios en formato cron, en la hora de Bogotá. Diario: el anexo del boletín del DANE (unos 340 KB), de lunes a viernes
# a las 3:00 p. m.; el DANE lo publica hacia las 2:00. Semanal: la serie completa del servicio web (unos 300 MB), los
# domingos a las 3:00 p. m.
AGROSENSE_MARKET_DAILY_SCHEDULE=0 15 * * 1-5
AGROSENSE_MARKET_WEEKLY_SCHEDULE=0 15 * * 0
# Tiempo máximo de cada descarga, contado de punta a punta (no por lectura), y tamaño máximo en MB. Los usan los crons y
# `uv run python -m pipeline.build --descargar`.
AGROSENSE_MARKET_TIMEOUT_S=900
AGROSENSE_MARKET_MAX_MB=600

# Logs de la terminal: nivel (DEBUG solo en desarrollo, INFO, WARNING, ERROR) y formato (console o json).
AGROSENSE_LOG_LEVEL=INFO
AGROSENSE_LOG_FORMAT=console

# Pipeline: descargas de NASA POWER (HU-041), solo con `uv run python -m pipeline.build --descargar`. Sin --descargar
# el pipeline no usa la red. Tiempo máximo de cada celda, contado de punta a punta (no por lectura), y tamaño máximo de
# cada respuesta, en MB. Hoy una celda pesa unos 0,8 MB y baja en unos 3 s.
AGROSENSE_POWER_TIMEOUT_S=120
AGROSENSE_POWER_MAX_MB=10
# NASADEM (HU-206), también solo con --descargar: tiempo y tamaño máximos de cada mosaico de 1°. Hoy uno pesa unos
# 20 MB y baja en unos 8 s; la región necesita 13.
AGROSENSE_NASADEM_TIMEOUT_S=300
AGROSENSE_NASADEM_MAX_MB=60
