# HU-022: caja con Python y Node para correr lint, pruebas y build con un solo comando (`docker compose run --rm test`).
# Tiene Python (Ruff, pytest) y Node (Vitest, build de la web) en la misma caja.
# El código NO se copia aquí: Compose monta el repo, así siempre se prueba lo que hay en disco.
FROM python:3.12-slim

# pg_dump: las pruebas de copia de seguridad lo necesitan (igual que la imagen de la app).
# tzdata: por si alguna prueba depende de la hora de Bogotá.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client tzdata \
 && rm -rf /var/lib/apt/lists/*

 # Misma versión de uv que la imagen de la app (Dockerfile de la raíz): si una cambia, cambia la otra.
COPY --from=ghcr.io/astral-sh/uv:0.13.0 /uv /uvx /bin/

# Node 22 copiado de la imagen oficial. No se copia /usr/local entero porque taparía Python.
COPY --from=node:22-slim /usr/local/bin/node /usr/local/bin/node
COPY --from=node:22-slim /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# El entorno de Python vive en /opt/venv, fuera de /repo: Compose monta el repo encima de /repo
# y no debe tapar las dependencias. UV_NO_SYNC evita que `uv run` reinstale al ejecutar.
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_NO_SYNC=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /repo
# Primero solo los archivos de dependencias: esta capa se reutiliza mientras no cambie uv.lock.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen