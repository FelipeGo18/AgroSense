# Copie este archivo como .env. Las variables VITE_* quedan a la vista en el navegador: aquí no van secretos.

# Redes del equipo en el pie de página. Una red sin dirección no se dibuja.
VITE_SOCIAL_GITHUB=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_YOUTUBE=

# Música de fondo: dirección de un archivo de audio (por ejemplo /audio/tema.mp3, puesto en web/public/audio/).
# Vacío: suena una melodía generada por la propia web.
VITE_MUSIC_URL=

# Respuestas simuladas (HU-013): true hace que, en `npm run dev`, el diagnóstico, las estrategias, el plan de agua,
# «Qué cambió», las tendencias, el suelo y los catálogos respondan con ejemplos, sin el motor. Cada estado se fuerza con
# ?estado= en la dirección (por ejemplo ?estado=no_apto). Las cuentas siguen yendo a la API real. Nunca en producción.
VITE_SIMULATION=
