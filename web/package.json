{
  "name": "agrosense-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/app/entry-server.tsx --outDir node_modules/.agrosense-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scroll": "node e2e/scroll-stress.mjs",
    "perf": "node e2e/perf.mjs",
    "test:responsive": "node e2e/responsive-check.mjs",
    "api:types": "npx --yes openapi-typescript@7.13.0 http://127.0.0.1:8000/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@gsap/react": "2.1.2",
    "@radix-ui/react-dialog": "1.3.0",
    "@tanstack/react-query": "5.104.2",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "lighthouse": "12.8.2",
    "playwright-core": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
